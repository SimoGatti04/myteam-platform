# Local-only PostgreSQL started by `pnpm db:up`.
DATABASE_URL=postgresql://myteam:local-dev-only@127.0.0.1:54329/myteam_platform
TEST_DATABASE_URL=postgresql://myteam:local-dev-only@127.0.0.1:54329/myteam_platform_test

HOST=127.0.0.1
PORT=3000

# Optional for local public reads. Admin writes fail closed with HTTP 503 until configured.
# Use the exact issuer, API resource audience, and JWKS URL from the existing Logto instance.
LOGTO_ISSUER=
LOGTO_AUDIENCE=
LOGTO_JWKS_URL=
# Proposed permission name; it must match the permission assigned to Logto's `admin` role.
LOGTO_ADMIN_SCOPE=platform:admin
