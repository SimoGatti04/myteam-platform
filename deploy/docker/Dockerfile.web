# Multi-stage Dockerfile for @myteam/web production
# Stage 1: Build Vite SPA
FROM node:26-alpine@sha256:c6ad9e9c1d80f6eb607c26b4b0a132ff7a2344fad1c78ea3baa2a7d4c8de6d94 AS builder

WORKDIR /app

RUN npm install -g pnpm@10.32.1

# Copy root manifest and workspace configuration
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY packages/contracts/package.json ./packages/contracts/
COPY apps/web/package.json ./apps/web/

# Install dependencies (frozen lockfile)
RUN pnpm install --frozen-lockfile

# Copy sources
COPY tsconfig.base.json ./
COPY packages/contracts/ ./packages/contracts/
COPY apps/web/ ./apps/web/

# Build contracts first, then build Vite application
# Build arguments for Vite environment embedding
ARG VITE_APP_ENV=production
ARG VITE_LOGTO_ENDPOINT=https://auth.simogatti.it/oidc
ARG VITE_LOGTO_APP_ID=""
ARG VITE_LOGTO_API_RESOURCE=https://team-staging.simogatti.it/api
ARG VITE_LOGTO_SCOPES="openid profile platform:admin"
ARG VITE_LOGTO_REDIRECT_URI=https://team-staging.simogatti.it/callback
ARG VITE_LOGTO_POST_LOGOUT_REDIRECT_URI=https://team-staging.simogatti.it
ARG VITE_ENABLE_DEMO=false

ENV VITE_APP_ENV=${VITE_APP_ENV}
ENV VITE_LOGTO_ENDPOINT=${VITE_LOGTO_ENDPOINT}
ENV VITE_LOGTO_APP_ID=${VITE_LOGTO_APP_ID}
ENV VITE_LOGTO_API_RESOURCE=${VITE_LOGTO_API_RESOURCE}
ENV VITE_LOGTO_SCOPES=${VITE_LOGTO_SCOPES}
ENV VITE_LOGTO_REDIRECT_URI=${VITE_LOGTO_REDIRECT_URI}
ENV VITE_LOGTO_POST_LOGOUT_REDIRECT_URI=${VITE_LOGTO_POST_LOGOUT_REDIRECT_URI}
ENV VITE_ENABLE_DEMO=${VITE_ENABLE_DEMO}

RUN pnpm --filter @myteam/contracts build && \
    pnpm --filter @myteam/web build

# Stage 2: Serve with non-root Nginx
FROM nginx:1.30.6-alpine-slim@sha256:dede8895648b461178c3bc604f7eed4423efe5220b2c4d839f5eb3d34ac3f8f7 AS runner

# Remove default server config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom non-root nginx configuration
COPY deploy/docker/nginx.conf /etc/nginx/nginx.conf

# Copy static assets from builder stage
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Create temp directories with correct permissions for nginx non-root
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx /var/log/nginx /etc/nginx && \
    touch /tmp/nginx.pid && \
    chown -R nginx:nginx /tmp/nginx.pid

USER nginx

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
