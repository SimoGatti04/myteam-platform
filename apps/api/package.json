{
  "name": "@myteam/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "migrate": "node --env-file-if-exists=../../.env --import tsx src/persistence/migrate-cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/unit/*.test.ts",
    "test:integration": "REQUIRE_POSTGRES_INTEGRATION=1 node --env-file-if-exists=../../.env --import tsx --test test/integration/*.test.ts"
  },
  "dependencies": {
    "@myteam/contracts": "workspace:*",
    "fastify": "^5.0.0",
    "jose": "^6.2.13",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
